# Local development env vars (loaded when AWS_LAMBDA_FUNCTION_NAME is unset)
FINNHUB_API_KEY=your_finnhub_key
GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_BOT_TOKEN=123:abc
TELEGRAM_WEBHOOK_SECRET=replace-with-32-char-random-string

# DynamoDB / SQS resource names (override per environment)
CONVERSATIONS_TABLE=earnings-agent-conversations
SUBSCRIBERS_TABLE=earnings-agent-subscribers
PROCESSED_UPDATES_TABLE=earnings-agent-processed-updates
UPDATES_QUEUE_URL=

AWS_REGION=ap-northeast-1
